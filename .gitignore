# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# Only pnpm-lock.yaml should be committed. Reject npm/yarn artifacts.
package-lock.json
yarn.lock
npm-shrinkwrap.json

# ─── Next.js build output ─────────────────────────────────────────────────────
.next/
out/
build/
dist/

# ─── Environment secrets — NEVER COMMIT ───────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging

# ─── Vercel deployment artifacts ──────────────────────────────────────────────
.vercel/

# ─── Test / coverage ─────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Supabase local ──────────────────────────────────────────────────────────
supabase/.temp/
supabase/functions/.cache/

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Debug logs ───────────────────────────────────────────────────────────────
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts
