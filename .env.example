# ============================================================
# ENVIRONMENT VARIABLES — EXAMPLE FILE
# Copy this to .env.local and fill in actual values
# NEVER commit .env.local
# ============================================================

# Supabase (get from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application — canonical public URL (SEO, sitemap, Open Graph)
# Local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (Vercel): https://www.sestakibris.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Cron authentication (generate a strong random string, used by cron-job.org)
# Send as: Authorization: Bearer <CRON_SECRET>
# Set the SAME value in cron-job.org job header configuration.
CRON_SECRET=

# First admin: open /setup-admin once on an empty project (no admin in Auth yet).
# If admin exists but password is lost:
#   pnpm admin:reset-password
#   OR POST /api/admin/reset-admin-password with Authorization: Bearer <CRON_SECRET>
# Bootstrap stays locked; recovery only resets the existing admin password.

# --- Stripe Connect MVP ---
# Dashboard → Developers → API keys (test mode first)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Local: stripe listen --forward-to localhost:3000/api/stripe/webhooks
STRIPE_WEBHOOK_SECRET=

# --- Phase 2+ only (Web Push) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
