# Hoist packages to node_modules root so Next.js and PostCSS tooling can resolve them.
# Required for Tailwind CSS v4 + @tailwindcss/postcss in Next.js App Router.
shamefully-hoist=true

# Automatically install peer dependencies instead of failing.
auto-install-peers=true

# Do not abort on unresolved peer dependency warnings.
# Some Next.js ecosystem packages lag behind React 19 peer declarations.
strict-peer-dependencies=false

# Always verify the integrity of downloaded packages.
verify-store-integrity=true
